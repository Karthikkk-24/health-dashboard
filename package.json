{
  "name": "health-dashboard",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @health-dashboard/web dev",
    "dev:api": "pnpm --filter @health-dashboard/api start:dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @health-dashboard/api test",
    "typecheck": "pnpm --filter @health-dashboard/api exec tsc --noEmit && pnpm --filter @health-dashboard/web exec tsc --noEmit",
    "ci": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "nanoid": ">=3.3.17",
      "postcss": ">=8.5.26",
      "fast-uri": ">=3.1.5"
    }
  },
  "packageManager": "pnpm@10.18.3"
}
