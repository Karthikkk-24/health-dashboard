{
  "name": "health-dashboard",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @health-dashboard/web dev",
    "dev:api": "pnpm --filter @health-dashboard/api start:dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "nanoid": ">=3.3.17",
      "postcss": ">=8.5.26"
    }
  },
  "packageManager": "pnpm@10.18.3"
}
